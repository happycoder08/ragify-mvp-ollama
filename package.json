{
  "name": "ragify",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd apps/backend && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev:frontend": "npm --prefix apps/frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
