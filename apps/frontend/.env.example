# RAGify Frontend Configuration

# Backend API URL for development proxy
# The Vite dev server will proxy /api requests to this URL
# Example: http://localhost:8000
VITE_API_URL=http://localhost:8000

# Demo Mode Configuration
# Set to 'true' to enable demo mode with quick demo buttons
VITE_DEMO_MODE=false

# Demo Questions (only used when VITE_DEMO_MODE=true)
# Q1: Question that should have grounded evidence in your documents
VITE_DEMO_Q1=What is the company vacation policy?

# Q2: Question that should trigger a refusal (no relevant evidence)
VITE_DEMO_Q2=What is the weather forecast for tomorrow?
